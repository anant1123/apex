# Copy this file to .env for local development.
# On Render, set these same keys under your Web Service → Environment tab —
# do NOT commit a real .env file (it's already in .gitignore).

# --- Groq (console.groq.com/keys — free, no credit card) ---
GROQ_API_KEY=gsk_your_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# --- MongoDB Atlas (cloud.mongodb.com — free M0 cluster) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=apex_db

# --- Flask ---
FLASK_SECRET_KEY=change-this-to-a-random-string
MAX_UPLOAD_MB=10
SESSION_LIFETIME_DAYS=30

# --- Email OTP login (Resend HTTP API — NOT SMTP) ---
# Render's free tier blocks outbound SMTP ports, so OTP emails go out over
# Resend's REST API instead (plain HTTPS, never blocked). resend.com → sign
# up free (100 emails/day, 3,000/month, no credit card) → API Keys → create one.
# Until you verify your own domain at resend.com/domains, RESEND_FROM_EMAIL
# must stay "onboarding@resend.dev", and Resend will only deliver to the
# single email address your Resend account itself is registered with — fine
# for logging in as yourself, not for other people until a domain is verified.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=A.P.E.X.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
