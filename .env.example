# Copy this file to .env for local development.
# On Render, set these same keys under your Web Service → Environment tab —
# do NOT commit a real .env file (it's already in .gitignore).

# --- Groq (console.groq.com/keys — free, no credit card) ---
GROQ_API_KEY=gsk_your_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b

# --- MongoDB Atlas (cloud.mongodb.com — free M0 cluster) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=apex_db

# --- Flask ---
FLASK_SECRET_KEY=change-this-to-a-random-string
MAX_UPLOAD_MB=10
SESSION_LIFETIME_DAYS=30

# --- Email OTP login (SMTP) ---
# Gmail: enable 2-Step Verification on your Google account, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it
# below (NOT your normal Gmail password). Any other SMTP provider works too
# (Brevo, Resend's SMTP endpoint, your college mail server) — just change
# SMTP_HOST/SMTP_PORT accordingly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=A.P.E.X.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
